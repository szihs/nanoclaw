+        h.insert(CONTENT_TYPE, HeaderValue::from_str(content_type).unwrap());
+        if let Some(e) = encoding {
+            h.insert(CONTENT_ENCODING, HeaderValue::from_str(e).unwrap());
+        }
+        h
+    }
