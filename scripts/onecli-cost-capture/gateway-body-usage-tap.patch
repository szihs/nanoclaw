+    #[test]
+    fn chat_completion_chunk_with_usage() {
+        let sse = "data: {\"id\":\"c\",\"object\":\"chat.completion.chunk\",\"model\":\"gpt-x\",\"choices\":[{\"delta\":{\"content\":\"hi\"}}]}\n\n\
+data: {\"id\":\"c\",\"object\":\"chat.completion.chunk\",\"model\":\"gpt-x\",\"choices\":[],\"usage\":{\"prompt_tokens\":30,\"completion_tokens\":4}}\n\n\
+data: [DONE]\n\n";
+        let out = run("text/event-stream", None, sse.as_bytes(), 9);
