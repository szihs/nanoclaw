+    #[test]
+    fn host_allowlist() {
+        let allow = vec!["inference-api.nvidia.com".to_string()];
+        assert!(host_allowed("inference-api.nvidia.com:443", &allow));
+        assert!(host_allowed("INFERENCE-API.nvidia.com", &allow));
+        assert!(!host_allowed("api.github.com:443", &allow));
+        assert!(!host_allowed("inference-api.nvidia.com:443", &[]));
+        assert!(host_allowed("anything:443", &["*".to_string()]));
+    }
