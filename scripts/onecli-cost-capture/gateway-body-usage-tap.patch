+
+    /// The tapped stream must forward every byte unchanged, in order, even
+    /// when the body is malformed, and must not panic on drop.
+    #[tokio::test]
+    async fn tapped_stream_is_byte_identical_passthrough() {
+        let chunks: Vec<&'static [u8]> = vec![
+            b"event: message_start\ndata: {\"type\":\"message_start\",\"message\":{\"usage\":{\"input_tokens\":3}}}\n\n",
+            b"data: {\"type\":\"message_delta\",\"usage\":{\"output_tok",
+            b"ens\":5}}\n\ndata: {broken\n\n",
+        ];
+        let expected: Vec<u8> = chunks.concat();
+        let mut headers = hyper::HeaderMap::new();
+        headers.insert(CONTENT_TYPE, HeaderValue::from_static("text/event-stream"));
+        let inner = futures_util::stream::iter(
+            chunks.into_iter().map(|c| Ok::<Bytes, reqwest::Error>(Bytes::from_static(c))),
