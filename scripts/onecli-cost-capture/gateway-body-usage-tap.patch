+/// Pass-through body stream that lets the usage tap observe each chunk and
+/// emits the telemetry event only once the upstream body has ended (or the
+/// client went away), so end-of-stream token usage rides along in
+/// `extra_data`. Bytes are forwarded unchanged and without buffering.
+struct TappedStream {
+    inner: Pin<Box<dyn Stream<Item = Result<Bytes, reqwest::Error>> + Send>>,
+    tap: Option<super::usage_tap::UsageTap>,
+    event: Option<crate::telemetry::RequestEvent>,
+    extra: serde_json::Map<String, serde_json::Value>,
+}
+
+impl TappedStream {
+    /// Emit the (single) telemetry event with headers + body usage merged.
+    fn finish(&mut self) {
+        let Some(mut event) = self.event.take() else {
+            return;
+        };
+        let mut extra = std::mem::take(&mut self.extra);
+        if let Some(tap) = self.tap.take() {
+            for (k, v) in tap.finish() {
+                extra.insert(k, v);
+            }
+        }
+        event.captured_headers = extra_data_json(extra);
+        crate::telemetry::on_request(event);
+    }
+}
+
+impl Stream for TappedStream {
+    type Item = Result<Frame<Bytes>, reqwest::Error>;
+
+    fn poll_next(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Option<Self::Item>> {
+        let this = self.get_mut();
+        match this.inner.as_mut().poll_next(cx) {
+            Poll::Ready(Some(Ok(bytes))) => {
+                if let Some(tap) = this.tap.as_mut() {
+                    tap.observe(&bytes);
+                }
+                Poll::Ready(Some(Ok(Frame::data(bytes))))
+            }
+            Poll::Ready(Some(Err(e))) => {
+                this.finish();
+                Poll::Ready(Some(Err(e)))
+            }
+            Poll::Ready(None) => {
+                this.finish();
+                Poll::Ready(None)
+            }
+            Poll::Pending => Poll::Pending,
+        }
+    }
+}
+
+impl Drop for TappedStream {
+    /// Client disconnect / abandoned stream: still record what we have.
+    fn drop(&mut self) {
+        self.finish();
+    }
+}
