+
+    #[test]
+    fn malformed_bodies_are_fail_soft() {
+        let bad_sse = b"data: {\"type\":\"message_delta\",\"usage\":{\"output_tokens\":\n\ndata: [DONE]\n\n";
+        let out = run("text/event-stream", None, bad_sse, 6);
+        assert_eq!(out["usage_source"], "unavailable-parse");
+        assert_eq!(out["usage_parse_errors"], 1);
+        assert!(out.get("usage_input_tokens").is_none());
+
+        let bad_json = b"{\"usage\": not json";
+        let out = run("application/json", None, bad_json, 100);
+        assert_eq!(out["usage_source"], "unavailable-parse");
