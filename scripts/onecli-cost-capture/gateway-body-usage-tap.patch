+    /// Feed `body` in `n`-byte chunks and return the usage keys minus the
+    /// timing fields (which legitimately differ between runs).
+    fn run(content_type: &str, encoding: Option<&str>, body: &[u8], n: usize) -> Map<String, Value> {
+        let mut tap = UsageTap::from_headers(&headers(content_type, encoding));
+        for chunk in body.chunks(n.max(1)) {
+            tap.observe(chunk);
+        }
+        let mut out = tap.finish();
+        out.remove("usage_body_ms");
+        out.remove("usage_observed_at_ms");
+        out
+    }
