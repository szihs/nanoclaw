+//! Response-body usage tap.
+//!
+//! Streamed LLM responses (`text/event-stream`) send their HTTP headers before
+//! the completion exists, so any upstream per-request *cost* header is `0` for
+//! them. The token usage IS in the body — in the final SSE event(s). This
+//! module observes the upstream body bytes as they pass through
+//! `hooks::track_and_wrap`, keeps ONLY a small typed usage snapshot, and hands
+//! it back (as flat `usage_*` keys) to be merged into `request_logs.extra_data`
+//! once the stream has ended.
+//!
+//! Guarantees:
+//! - bytes forwarded to the client are never modified, buffered whole, or
+//!   delayed — the scanner only *looks* at each chunk;
+//! - bounded memory: at most one partial SSE line (or one non-streamed JSON
+//!   body) up to `DEFAULT_MAX_BUFFER` is held; everything else is a few words;
+//! - fail-soft: any problem degrades to a `usage_source: unavailable-*` marker,
+//!   never an error on the client path, never a body excerpt in logs;
+//! - no pricing: raw token counts + model id only; consumers price them.
+//!
+//! Opt-in via `ONECLI_CAPTURE_BODY_USAGE_HOSTS` — comma-separated upstream
+//! hosts (with or without `:port`), or `*` for all. Unset = stock behaviour.
+//!
+//! Recognised shapes (all fields optional, unknown fields ignored):
+//! - Anthropic Messages: SSE `message_start.message.{model,usage}` (initial)
+//!   then `message_delta.usage` (cumulative, final); non-streamed JSON
+//!   `{type:"message", model, usage}`.
+//! - OpenAI Responses: SSE `response.completed|incomplete|failed
+//!   .response.{model,usage}`; non-streamed JSON `{object:"response", model, usage}`.
+//! - OpenAI Chat Completions: `{object:"chat.completion[.chunk]", model, usage}`.
+//!
+//! Semantics consumers must respect: OpenAI `input_tokens`/`prompt_tokens`
+//! INCLUDE cached tokens; Anthropic `input_tokens` EXCLUDES cache reads and
+//! cache creation; `usage_cache_creation_input_tokens` is the aggregate and
+//! the `5m`/`1h` keys are its breakdown (never sum both). `usage_api` tells
+//! which convention applies.
+
+use std::sync::OnceLock;
+use std::time::{Instant, SystemTime, UNIX_EPOCH};
+
+use serde::Deserialize;
+use serde_json::{Map, Value};
+
+/// Largest single SSE line (or non-streamed JSON body) held at once. OpenAI's
+/// `response.completed` carries the whole response, so this is generous;
+/// beyond it scanning stops and `usage_source: unavailable-oversize` is reported.
+pub(crate) const DEFAULT_MAX_BUFFER: usize = 8 * 1024 * 1024;
+
+fn tap_hosts() -> &'static [String] {
+    static HOSTS: OnceLock<Vec<String>> = OnceLock::new();
+    HOSTS.get_or_init(|| {
+        std::env::var("ONECLI_CAPTURE_BODY_USAGE_HOSTS")
+            .unwrap_or_default()
+            .split(',')
+            .map(|s| s.trim().to_ascii_lowercase())
+            .filter(|s| !s.is_empty())
+            .collect()
+    })
+}
+
+/// Whether responses from `host` (as logged, e.g. `inference-api.nvidia.com:443`)
+/// should be tapped. False when the env allowlist is unset.
+pub(crate) fn wants_host(host: &str) -> bool {
+    host_allowed(host, tap_hosts())
+}
+
+fn host_allowed(host: &str, allow: &[String]) -> bool {
+    if allow.is_empty() {
+        return false;
+    }
+    let h = host.to_ascii_lowercase();
+    let bare = h.split(':').next().unwrap_or("");
+    allow.iter().any(|p| p == "*" || *p == h || p == bare)
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum Mode {
+    Sse,
+    Json,
+    Compressed,
+    Unsupported,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum Api {
+    AnthropicMessages,
+    OpenAiResponses,
+    OpenAiChat,
+}
+
+impl Api {
+    fn as_str(self) -> &'static str {
+        match self {
+            Api::AnthropicMessages => "anthropic_messages_v1",
+            Api::OpenAiResponses => "openai_responses_v1",
+            Api::OpenAiChat => "openai_chat_completions_v1",
+        }
+    }
+}
+
+#[derive(Default, Deserialize, Debug, Clone, PartialEq, Eq)]
+#[serde(default)]
+struct CacheCreation {
+    ephemeral_5m_input_tokens: Option<u64>,
+    ephemeral_1h_input_tokens: Option<u64>,
+}
+
+#[derive(Default, Deserialize, Debug, Clone, PartialEq, Eq)]
+#[serde(default)]
+struct TokenDetails {
+    cached_tokens: Option<u64>,
+    reasoning_tokens: Option<u64>,
+}
+
+/// Union of the usage shapes we understand.
+#[derive(Default, Deserialize, Debug, Clone, PartialEq, Eq)]
+#[serde(default)]
+struct Usage {
+    // Anthropic Messages + OpenAI Responses
+    input_tokens: Option<u64>,
+    output_tokens: Option<u64>,
+    // Anthropic
+    cache_creation_input_tokens: Option<u64>,
+    cache_read_input_tokens: Option<u64>,
+    cache_creation: Option<CacheCreation>,
+    // OpenAI Responses
+    input_tokens_details: Option<TokenDetails>,
+    output_tokens_details: Option<TokenDetails>,
+    total_tokens: Option<u64>,
+    // OpenAI Chat Completions
+    prompt_tokens: Option<u64>,
+    completion_tokens: Option<u64>,
+    prompt_tokens_details: Option<TokenDetails>,
+    completion_tokens_details: Option<TokenDetails>,
+}
+
+impl Usage {
+    /// Field-wise overlay: values present in `later` replace ours. SSE counters
+    /// are cumulative, so the final event wins; Anthropic's `message_delta`
+    /// may omit input-side fields that only `message_start` carried.
+    fn overlay(&mut self, later: Usage) {
+        macro_rules! take {
+            ($($f:ident),* $(,)?) => { $( if later.$f.is_some() { self.$f = later.$f; } )* };
+        }
+        take!(
+            input_tokens,
+            output_tokens,
+            cache_creation_input_tokens,
+            cache_read_input_tokens,
+            cache_creation,
+            input_tokens_details,
+            output_tokens_details,
+            total_tokens,
+            prompt_tokens,
+            completion_tokens,
+            prompt_tokens_details,
+            completion_tokens_details,
+        );
+    }
+
+    fn is_empty(&self) -> bool {
+        *self == Usage::default()
+    }
+}
+
+#[derive(Default, Deserialize)]
+#[serde(default)]
+struct MsgLike {
+    model: Option<String>,
+    usage: Option<Usage>,
+}
+
+/// One SSE `data:` payload or one non-streamed JSON body, loosely typed.
+#[derive(Default, Deserialize)]
+#[serde(default)]
+struct Envelope {
+    #[serde(rename = "type")]
+    kind: Option<String>,
+    object: Option<String>,
+    model: Option<String>,
+    usage: Option<Usage>,
+    /// Anthropic `message_start`.
+    message: Option<MsgLike>,
+    /// OpenAI `response.*` events.
+    response: Option<MsgLike>,
+}
+
+/// Incremental, bounded, panic-free usage scanner for one response body.
+pub(crate) struct UsageTap {
+    mode: Mode,
+    max_buffer: usize,
+    buf: Vec<u8>,
+    api: Option<Api>,
+    model: Option<String>,
+    usage: Option<Usage>,
+    /// A terminal usage event was seen (final SSE usage / whole JSON body).
+    complete: bool,
+    oversize: bool,
+    parse_errors: u32,
+    started: Instant,
+}
+
+impl UsageTap {
+    /// Decide the scanning mode from the upstream response headers.
+    pub(crate) fn from_headers(headers: &hyper::HeaderMap) -> Self {
+        let encoding = headers
+            .get(hyper::header::CONTENT_ENCODING)
+            .and_then(|v| v.to_str().ok())
+            .map(|s| s.trim().to_ascii_lowercase())
+            .unwrap_or_default();
+        let content_type = headers
+            .get(hyper::header::CONTENT_TYPE)
+            .and_then(|v| v.to_str().ok())
+            .map(|s| s.trim().to_ascii_lowercase())
+            .unwrap_or_default();
+        let mode = if !encoding.is_empty() && encoding != "identity" {
+            Mode::Compressed
+        } else if content_type.starts_with("text/event-stream") {
+            Mode::Sse
+        } else if content_type.starts_with("application/json") {
+            Mode::Json
+        } else {
+            Mode::Unsupported
+        };
+        Self {
+            mode,
+            max_buffer: DEFAULT_MAX_BUFFER,
+            buf: Vec::new(),
+            api: None,
+            model: None,
+            usage: None,
+            complete: false,
+            oversize: false,
+            parse_errors: 0,
+            started: Instant::now(),
+        }
+    }
+
+    #[cfg(test)]
+    fn with_max_buffer(mut self, max_buffer: usize) -> Self {
+        self.max_buffer = max_buffer;
+        self
+    }
+
+    /// Observe one chunk of the upstream body. Never modifies or retains the
+    /// chunk beyond the current partial line / bounded JSON buffer.
+    pub(crate) fn observe(&mut self, chunk: &[u8]) {
+        match self.mode {
+            Mode::Compressed | Mode::Unsupported => {}
+            Mode::Json => {
+                if self.oversize {
+                    return;
+                }
+                if self.buf.len() + chunk.len() > self.max_buffer {
+                    self.oversize = true;
+                    self.buf = Vec::new();
+                } else {
+                    self.buf.extend_from_slice(chunk);
+                }
+            }
+            Mode::Sse => {
+                if self.oversize {
+                    return;
+                }
+                if self.buf.len() + chunk.len() > self.max_buffer {
+                    self.oversize = true;
+                    self.buf = Vec::new();
+                    return;
+                }
+                self.buf.extend_from_slice(chunk);
+                let buf = std::mem::take(&mut self.buf);
+                let mut start = 0usize;
+                while let Some(rel) = buf[start..].iter().position(|&b| b == b'\n') {
+                    let end = start + rel;
+                    let mut line = &buf[start..end];
+                    if let Some(stripped) = line.strip_suffix(b"\r") {
+                        line = stripped;
+                    }
+                    self.handle_sse_line(line);
+                    start = end + 1;
+                }
+                // Keep only the trailing partial line for the next chunk.
+                self.buf = buf[start..].to_vec();
+            }
+        }
+    }
+
+    fn handle_sse_line(&mut self, line: &[u8]) {
+        let Some(rest) = line.strip_prefix(b"data:") else {
+            return;
+        };
+        let payload = trim_ascii_start(rest);
+        // Cheap pre-filter: only JSON objects that mention "usage" at all.
+        if payload.first() != Some(&b'{') || !contains(payload, b"\"usage\"") {
+            return;
+        }
+        match serde_json::from_slice::<Envelope>(payload) {
+            Ok(env) => self.absorb(env),
+            Err(_) => self.parse_errors = self.parse_errors.saturating_add(1),
+        }
+    }
+
+    /// Classify one envelope and fold its usage/model into the snapshot.
+    fn absorb(&mut self, env: Envelope) {
+        let kind = env.kind.as_deref().unwrap_or("");
+        let object = env.object.as_deref().unwrap_or("");
+        let (api, model, usage, terminal) = if kind == "message_start" {
+            let m = env.message.unwrap_or_default();
+            (Api::AnthropicMessages, m.model, m.usage, false)
+        } else if kind == "message_delta" || kind == "message" {
+            (Api::AnthropicMessages, env.model, env.usage, true)
+        } else if kind.starts_with("response.")
+            && env.response.as_ref().is_some_and(|r| r.usage.is_some())
+        {
+            let r = env.response.unwrap_or_default();
+            (Api::OpenAiResponses, r.model, r.usage, true)
+        } else if object == "response" {
+            (Api::OpenAiResponses, env.model, env.usage, true)
+        } else if object == "chat.completion" || object == "chat.completion.chunk" {
+            (Api::OpenAiChat, env.model, env.usage, true)
+        } else {
+            return;
+        };
+        self.api = Some(api);
+        if model.is_some() {
+            self.model = model;
+        }
+        if let Some(u) = usage {
+            if !u.is_empty() {
+                match self.usage.as_mut() {
+                    Some(cur) => cur.overlay(u),
+                    None => self.usage = Some(u),
+                }
+                if terminal {
+                    self.complete = true;
+                }
+            }
+        }
+    }
+
+    /// Consume the tap at end of body and produce the flat `usage_*` keys.
+    pub(crate) fn finish(mut self) -> Map<String, Value> {
+        if self.mode == Mode::Json && !self.oversize && !self.buf.is_empty() {
+            let buf = std::mem::take(&mut self.buf);
+            if contains(&buf, b"\"usage\"") {
+                match serde_json::from_slice::<Envelope>(&buf) {
+                    Ok(env) => self.absorb(env),
+                    Err(_) => self.parse_errors = self.parse_errors.saturating_add(1),
+                }
+            }
+        }
+
+        let mut out = Map::new();
+        let source = match self.mode {
+            Mode::Compressed => "unavailable-compressed",
+            Mode::Unsupported => "unsupported-content-type",
+            Mode::Sse if self.usage.is_some() => "sse",
+            Mode::Json if self.usage.is_some() => "json",
+            _ if self.oversize => "unavailable-oversize",
+            _ if self.parse_errors > 0 => "unavailable-parse",
+            _ => "none",
+        };
+        out.insert("usage_source".to_string(), Value::from(source));
+        if let Some(api) = self.api {
+            out.insert("usage_api".to_string(), Value::from(api.as_str()));
+        }
+        if let Some(model) = self.model.take() {
+            out.insert("usage_model".to_string(), Value::from(model));
+        }
+        if let Some(u) = self.usage.take() {
+            let input = u.input_tokens.or(u.prompt_tokens);
+            let output = u.output_tokens.or(u.completion_tokens);
+            let cache_read = u
+                .cache_read_input_tokens
+                .or(u.input_tokens_details.as_ref().and_then(|d| d.cached_tokens))
+                .or(u.prompt_tokens_details.as_ref().and_then(|d| d.cached_tokens));
+            let reasoning = u
+                .output_tokens_details
+                .as_ref()
+                .and_then(|d| d.reasoning_tokens)
+                .or(u.completion_tokens_details.as_ref().and_then(|d| d.reasoning_tokens));
+            let (c5, c1) = match &u.cache_creation {
+                Some(c) => (c.ephemeral_5m_input_tokens, c.ephemeral_1h_input_tokens),
+                None => (None, None),
+            };
+            put(&mut out, "usage_input_tokens", input);
+            put(&mut out, "usage_output_tokens", output);
+            put(&mut out, "usage_cache_read_input_tokens", cache_read);
+            put(&mut out, "usage_cache_creation_input_tokens", u.cache_creation_input_tokens);
+            put(&mut out, "usage_cache_creation_5m_input_tokens", c5);
+            put(&mut out, "usage_cache_creation_1h_input_tokens", c1);
+            put(&mut out, "usage_reasoning_output_tokens", reasoning);
+            put(&mut out, "usage_total_tokens", u.total_tokens);
+            out.insert("usage_complete".to_string(), Value::Bool(self.complete));
+        }
+        if self.parse_errors > 0 {
+            out.insert("usage_parse_errors".to_string(), Value::from(self.parse_errors));
+        }
+        out.insert(
+            "usage_body_ms".to_string(),
+            Value::from(self.started.elapsed().as_millis() as u64),
+        );
+        let now_ms = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map(|d| d.as_millis() as u64)
+            .unwrap_or(0);
+        out.insert("usage_observed_at_ms".to_string(), Value::from(now_ms));
+        out
+    }
+}
+
+fn put(out: &mut Map<String, Value>, key: &str, v: Option<u64>) {
+    if let Some(n) = v {
+        out.insert(key.to_string(), Value::from(n));
+    }
+}
+
+fn trim_ascii_start(mut s: &[u8]) -> &[u8] {
+    while let Some((first, rest)) = s.split_first() {
+        if first.is_ascii_whitespace() {
+            s = rest;
+        } else {
+            break;
+        }
+    }
+    s
+}
+
+fn contains(hay: &[u8], needle: &[u8]) -> bool {
+    needle.is_empty() || hay.windows(needle.len()).any(|w| w == needle)
+}
