+
+    #[test]
+    fn oversize_line_is_reported_not_buffered() {
+        let mut tap = UsageTap::from_headers(&headers("text/event-stream", None)).with_max_buffer(64);
+        let long_line = format!("data: {{\"usage\":\"{}\"}}\n", "x".repeat(200));
+        for chunk in long_line.as_bytes().chunks(10) {
+            tap.observe(chunk);
+        }
+        assert!(tap.buf.len() <= 64);
+        let out = tap.finish();
+        assert_eq!(out["usage_source"], "unavailable-oversize");
+    }
+
+    #[test]
+    fn compressed_and_unsupported_bodies_are_not_scanned() {
+        let out = run("text/event-stream", Some("gzip"), ANTHROPIC_SSE.as_bytes(), 8);
+        assert_eq!(out["usage_source"], "unavailable-compressed");
+        assert!(out.get("usage_api").is_none());
+        let out = run("text/html", None, b"<html>usage</html>", 8);
+        assert_eq!(out["usage_source"], "unsupported-content-type");
+        // identity encoding is not compression
+        let out = run("text/event-stream", Some("identity"), ANTHROPIC_SSE.as_bytes(), 8);
+        assert_eq!(out["usage_source"], "sse");
+    }
