{
  "name": "nanoclaw",
  "version": "2.3.0",
  "description": "Personal AI assistant. Lightweight, secure, customizable.",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "main": "dist/index.js",
  "bin": {
    "ncl": "bin/ncl"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "node scripts/typecheck-gate.mjs",
    "check:runtime-deps": "node scripts/check-runtime-resolvable.mjs",
    "mailbox-model:generate": "cp src/mailbox/model.ts container/agent-runner/src/mailbox/model.generated.ts",
    "mailbox-model:check": "cmp src/mailbox/model.ts container/agent-runner/src/mailbox/model.generated.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "stdin-json:generate": "sh scripts/sync-stdin-json.sh",
    "stdin-json:check": "sh scripts/sync-stdin-json.sh --check",
    "prepare": "husky",
    "setup": "tsx setup/index.ts",
    "setup:auto": "tsx setup/auto.ts",
    "ncl": "tsx src/cli/client.ts",
    "migrate": "tsx scripts/migrate.ts",
    "release-notes": "node scripts/release-notes.mjs",
    "chat": "tsx scripts/chat.ts",
    "auth": "tsx src/whatsapp-auth.ts",
    "validate:templates": "tsx scripts/validate-templates.ts",
    "rebuild:claude": "tsx scripts/rebuild-claude-md.ts",
    "dashboard": "echo 'Dashboard runs inside the host process. Use: DASHBOARD_PORT=3737 npm run dev' && exit 1",
    "dashboard:preview": "npx tsx dashboard/server.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "HTTP_PROXY= HTTPS_PROXY= http_proxy= https_proxy= NODE_USE_ENV_PROXY= NO_PROXY='*' vitest run",
    "test:watch": "HTTP_PROXY= HTTPS_PROXY= http_proxy= https_proxy= NODE_USE_ENV_PROXY= NO_PROXY='*' vitest"
  },
  "dependencies": {
    "@chat-adapter/telegram": "4.29.0",
    "@clack/core": "^1.2.0",
    "@clack/prompts": "^1.2.0",
    "@onecli-sh/sdk": "2.2.1",
    "better-sqlite3": "13.0.3",
    "ccusage": "20.0.19",
    "chat": "4.29.0",
    "cron-parser": "5.5.0",
    "kleur": "^4.1.5",
    "supergateway": "^3.4.3",
    "tar-stream": "^3.1.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "eslint": "^9.35.0",
    "eslint-plugin-no-catch-all": "^1.1.0",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22"
  }
}
